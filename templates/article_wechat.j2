<section style="padding: 10px 0;">

<!-- 标题区 -->
<h1 style="font-size: 22px; font-weight: bold; color: #2c3e50; text-align: center; padding: 20px 10px; line-height: 1.4;">
    {{ title }}
</h1>

<!-- 摘要 -->
<p style="font-size: 14px; color: #7f8c8d; text-align: center; padding: 0 15px 20px; border-bottom: 1px solid #eee; margin-bottom: 20px;">
    {{ summary }}
</p>

{% if diagrams.architecture %}
<!-- 架构图 -->
<pre style="background: #f8f9fa; padding: 15px; border-radius: 8px; font-size: 12px; line-height: 1.6; overflow-x: auto; border-left: 4px solid #3498db;">
{{ diagrams.architecture }}
</pre>
{% endif %}

<!-- 1. 背景 -->
<h2 style="font-size: 18px; font-weight: bold; color: #2c3e50; margin: 30px 0 15px; padding-left: 10px; border-left: 3px solid #3498db;">
    📋 背景与问题
</h2>

<p style="font-size: 15px; color: #34495e; line-height: 1.8; margin: 10px 0;">
    {{ background.problem }}
</p>
<p style="font-size: 15px; color: #34495e; line-height: 1.8; margin: 10px 0;">
    {{ background.challenge }}
</p>
<p style="font-size: 15px; color: #e74c3c; line-height: 1.8; margin: 10px 0; padding: 10px; background: #fdf2f2; border-radius: 6px;">
    ⚠️ {{ background.stakes }}
</p>

<!-- 2. 根因 -->
<h2 style="font-size: 18px; font-weight: bold; color: #2c3e50; margin: 30px 0 15px; padding-left: 10px; border-left: 3px solid #e74c3c;">
    🔍 根因分析
</h2>

{% for cause in root_causes %}
<h3 style="font-size: 16px; font-weight: bold; color: #34495e; margin: 20px 0 10px;">
    {{ cause.level or '根因 ' ~ loop.index }}：{{ cause.title or '未命名' }}
</h3>
<p style="font-size: 15px; color: #555; line-height: 1.8; margin: 8px 0;">
    {{ cause.analysis }}
</p>
{% if cause.diagram %}
<pre style="background: #f8f9fa; padding: 12px; border-radius: 6px; font-size: 12px; overflow-x: auto;">
{{ cause.diagram }}
</pre>
{% endif %}
{% endfor %}

<!-- 3. 方案 -->
<h2 style="font-size: 18px; font-weight: bold; color: #2c3e50; margin: 30px 0 15px; padding-left: 10px; border-left: 3px solid #27ae60;">
    🛠 方案
</h2>

{% for solution in solutions %}
<h3 style="font-size: 16px; font-weight: bold; color: #34495e; margin: 20px 0 10px;">
    {{ solution.title }}
</h3>

<blockquote style="background: #eafaf1; padding: 10px 15px; border-left: 3px solid #27ae60; margin: 10px 0; border-radius: 4px; font-size: 14px; color: #1e8449;">
    💡 {{ solution.core_idea }}
</blockquote>

{% if solution.code_before %}
<p style="font-size: 13px; color: #e74c3c; margin: 15px 0 5px;">❌ Before：</p>
<pre style="background: #fff5f5; padding: 12px; border-radius: 6px; font-size: 13px; overflow-x: auto; border-left: 3px solid #e74c3c; line-height: 1.5;">
<code>{{ solution.code_before }}</code>
</pre>
{% endif %}

<p style="font-size: 13px; color: #27ae60; margin: 15px 0 5px;">✅ After：</p>
<pre style="background: #f0faf4; padding: 12px; border-radius: 6px; font-size: 13px; overflow-x: auto; border-left: 3px solid #27ae60; line-height: 1.5; margin-bottom: 10px;">
<code>{{ solution.code_after }}</code>
</pre>

<p style="font-size: 15px; color: #555; line-height: 1.8; margin: 8px 0;">
    {{ solution.explanation }}
</p>
{% endfor %}

<!-- 4. 决策表 -->
<h2 style="font-size: 18px; font-weight: bold; color: #2c3e50; margin: 30px 0 15px; padding-left: 10px; border-left: 3px solid #9b59b6;">
    🏗 架构决策
</h2>

<table style="width: 100%; border-collapse: collapse; font-size: 13px; margin: 15px 0;">
    <thead>
        <tr style="background: #3498db; color: white;">
            <th style="padding: 10px; border: 1px solid #3498db; text-align: left;">决策</th>
            <th style="padding: 10px; border: 1px solid #3498db; text-align: left;">替代方案</th>
            <th style="padding: 10px; border: 1px solid #3498db; text-align: left;">理由</th>
        </tr>
    </thead>
    <tbody>
    {% for decision in decisions %}
        <tr style="background: {{ loop.cycle('#ffffff', '#f8f9fa') }};">
            <td style="padding: 8px 10px; border: 1px solid #ddd; font-weight: bold;">{{ decision.choice }}</td>
            <td style="padding: 8px 10px; border: 1px solid #ddd; color: #e74c3c;">{{ decision.alternative }}</td>
            <td style="padding: 8px 10px; border: 1px solid #ddd;">{{ decision.rationale }}</td>
        </tr>
    {% endfor %}
    </tbody>
</table>

<!-- 5. 生产 -->
<h2 style="font-size: 18px; font-weight: bold; color: #2c3e50; margin: 30px 0 15px; padding-left: 10px; border-left: 3px solid #f39c12;">
    ⚡ 生产考量
</h2>

{% for item in production_notes %}
<p style="font-size: 15px; color: #34495e; line-height: 1.8; margin: 8px 0; padding: 8px 12px; background: #fef9e7; border-radius: 4px;">
    <strong>{{ item.topic }}：</strong>{{ item.detail }}
</p>
{% endfor %}

<!-- 6. 收获 -->
<h2 style="font-size: 18px; font-weight: bold; color: #2c3e50; margin: 30px 0 15px; padding-left: 10px; border-left: 3px solid #1abc9c;">
    💎 关键收获
</h2>

{% for takeaway in takeaways %}
<p style="font-size: 15px; color: #34495e; line-height: 1.8; margin: 10px 0; padding: 8px 15px; background: #e8f8f5; border-radius: 4px;">
    <strong style="color: #1abc9c;">{{ loop.index }}.</strong> {{ takeaway.body }}
</p>
{% endfor %}

<!-- 底部 -->
<p style="font-size: 12px; color: #bdc3c7; text-align: center; margin-top: 30px; padding-top: 15px; border-top: 1px solid #eee;">
</p>

</section>

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Data (generated at runtime)
data/sessions/*        # Raw Claude Code sessions (may contain private code)
data/cookies/*         # Platform login cookies (credentials)
data/debug/*           # Debug screenshots (may contain account pages)
data/traces/*          # Observability traces (LLM prompts/outputs)
data/logs/*            # Runtime logs
data/memory/*          # Agent memory
!data/**/.gitkeep

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
*.key
*_key.txt

# Claude Code
.claude/settings.local.json

# Config with secrets (real keys)
config/platforms.yaml
config/*.local.yaml
config/*.local.yml
